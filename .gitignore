# Raw downloads stay out of git (size and licence terms); hand-compiled research data is committed
data/raw/*
!data/raw/README.md
!data/raw/research/

# Large intermediate files
*.parquet
*.tif
# ... except the final burn map, which the QGIS project needs (about 5 MB)
!data/processed/s2_burn_classes_sangrur_2025.tif
*.tiff
*.nc
*.zip

# Python and notebooks
__pycache__/
.ipynb_checkpoints/
.venv/
venv/

# Secrets: never commit keys or passwords
.env
.env.txt
*.key
.streamlit/secrets.toml

# OS clutter
.DS_Store
Thumbs.db
desktop.ini

# Office lock files, created while a workbook is open
~$*
